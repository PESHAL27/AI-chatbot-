APP_NAME=PML Backend
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://127.0.0.1:5174,http://127.0.0.1:5173,http://localhost:3000

# AI Provider Configuration (OpenRouter / OpenAI)
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini
AI_API_KEY=your_openrouter_api_key_here
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048

# Web Search Providers (Phase 8: Web Search + AI Tool Calling)
# Default: 'duckduckgo' (No API key required)
# Optional premium engines: 'tavily', 'serper'
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=

# Supabase Database Configuration
SUPABASE_URL=https://axvbjoaqkanowkjoftxc.supabase.co
SUPABASE_KEY=your_supabase_publishable_or_anon_key_here
